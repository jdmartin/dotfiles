function __git_hooks_notice --on-variable PWD
   status is-interactive; or return

   set -l git_dir (command git rev-parse --absolute-git-dir 2>/dev/null)
   if test -z "$git_dir"
       set -g __git_hooks_notice_last
       return
   end

   # Only announce once per repo, not for every cd inside it.
   test "$git_dir" = "$__git_hooks_notice_last"; and return
   set -g __git_hooks_notice_last $git_dir

   # --git-path respects core.hooksPath; may be relative to cwd.
   set -l hooks_dir (path resolve (command git rev-parse --git-path hooks))
   set -l toplevel (command git rev-parse --show-toplevel 2>/dev/null)

   # Active hooks: executable regular files, ignoring *.sample
   set -l hooks
   for hook in $hooks_dir/*
       if test -f $hook -a -x $hook; and not string match -q '*.sample' -- $hook
           set -a hooks (path basename $hook)
       end
   end
   if set -q hooks[1]
       echo (set_color red)"git hooks:"(set_color normal) "$hooks (from $git_dir)"
   end

   # pre-commit / prek: config present but hook not installed?
   if test -n "$toplevel" -a -f "$toplevel/.pre-commit-config.yaml"
       set -l pc_tool
       set -l pc_hook $hooks_dir/pre-commit
       if test -f $pc_hook
           if grep -q 'File generated by prek:' $pc_hook
               set pc_tool prek
           else if grep -q 'File generated by pre-commit:' $pc_hook
               set pc_tool pre-commit
           end
       end
       if test -n "$pc_tool"
           echo "$pc_tool installed"
       else
           echo (set_color red)"pre-commit:"(set_color normal) \
               "not installed, run 'pre-commit install' or 'prek install'" \
               "($toplevel/.pre-commit-config.yaml)"
       end
   end
end

# PWD events don't fire for the starting directory, so check it once now.
status is-interactive; and __git_hooks_notice
